<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Watch time per app; granted once over ADB: appops set no.kongsnorre.tvstats GET_USAGE_STATS allow -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application android:allowBackup="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:label="@string/app_name" android:icon="@drawable/banner" android:banner="@drawable/banner">
        <activity android:name=".StatsActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.gathin.tvhome.category.DOCK_CARD" /></intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
        <!-- Logs what plays (title, show) for "Mest sett"; approved once over ADB:
             cmd notification allow_listener no.kongsnorre.tvstats/.WatchListener. Reads no notification. -->
        <service android:name=".WatchListener" android:exported="true" android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
